{
  "permissions": {
    "allow": [
      "Bash(npx tsc *)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npx eslint *)",
      "Bash(docker compose ps *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/vexp-hint.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/vexp-restore.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
